(* Headless Firefox against the pages of tests/pages, which each test serves itself on a free port. The tests start
   Firefox in the kept folder .cesia/firefox, where the first start makes the template of this version of Firefox; they
   run one after the other, so each one can check that its profile went. A test that needs several scenarios runs them
   on one browser, each on its page, since a start of Firefox takes about a second. *)
use src/browser
use std/bug
use std/cesia
use std/fiber
use std/http
use std/list
use std/net
use std/path
use std/result
use std/sys
use std/test
use std/text
use std/value

kept = ".cesia/firefox"

(* The name that Ceti gives the template of this version of Firefox. *)
templateName = "template-$(text.Replace(" ", "-", text.Trim(result.Unwrap(sys.Run("firefox", args = ["--full-version"])).Out)))"

defn served()
  (** The address of tests/pages, served by this test on a free port of this machine. *)
  l = net.Listen(0)?
  fiber.Spawn(() -> http.Serve(http.App() then http.Static("/", "tests/pages"), listener = l))
  result.Ok("http://127.0.0.1:$(net.Port(l))")
end

defn others(dir)
  (** The profiles in dir, and the templates being made, of runs that should have gone; the kept folders of the other
      test files, which run at the same time, are left out. *)
  result.Ok([name for name in sys.List(dir)? if text.StartsWith("profile-", name) or text.StartsWith("build-", name)])
end

defn on(page, f)
  (** f(p, site) on a new page at tests/pages/page, in a new Firefox, then the kept folder holds its template only. *)
  site = served()?
  out = browser.Firefox(defn (b)
    p = browser.NewPage(b)?
    browser.Go("$site/$page", p)?
    f(p, site)
  end, kept)
  left = others(kept)?
  if value.Len(left) != 0
    return result.Err("$kept still holds $left")
  end
  out
end

panicOf(f) = fiber.Wait(fiber.Spawn(f)).Error.Message   (* The message of the panic of f(), or missing. *)
kindOf(r) = r.Error.Kind
says(part, m) = value.IsText(m) and text.Contains(part, m)   (* Does a message, if there is one, hold the part? *)

defn isSignIn()
  on("form.html", defn (p, site)
    browser.Type("#name", "Ana", p)?
    browser.Click("#go", p)?
    list.All([
      browser.Text("#out", p)? == "clicked by Ana",
      value.Equal(browser.Texts(".item", p)?, ["one", "two", "hidden", "three"]),
      value.Len(browser.Texts(".none", p)?) == 0,
      browser.Eval("document.title", p)? == "Form",
      browser.Eval("navigator.webdriver", p)? == true])
  end)
end

defn isWaits()
  on("late.html", defn (p, site)
    never = browser.WaitFor("#never", p, timeout = 0.2)
    list.All([
      browser.WaitFor("#late", p)? == missing,
      browser.Text("#hidden", p)? == "hidden at first",
      browser.Text("#none", p)? == "not displayed at first",
      browser.Click("#off", p)? == missing,
      browser.Text("#said", p, timeout = 1)? == "on",
      kindOf(never) == "timeout",
      never.Error.Message == "#never: no element matches after 0.2 s"])
  end)
end

defn isTimeoutSaysWhy()
  on("form.html", defn (p, site)
    _ = browser.Eval("document.getElementById('go').disabled = true; document.getElementById('out').style.visibility = 'hidden'", p)?
    list.All([
      browser.Click("#go", p, timeout = 0.1).Error.Message == "#go: no visible element that is enabled (1 visible, all disabled) after 0.1 s",
      browser.Text("#out", p, timeout = 0.1).Error.Message == "#out: no visible element (1 match, none visible) after 0.1 s",
      browser.Type("#fixed", "x", p, timeout = 0.1).Error.Message == "#fixed: no visible field that is enabled and not read-only (1 visible) after 0.1 s",
      text.Contains("is no CSS selector", panicOf(() -> browser.Click("div[", p))),
      text.Contains("is no CSS selector", panicOf(() -> browser.Texts("div[", p))),
      text.Contains("is no field", panicOf(() -> browser.Type("h1", "x", p)))])
  end)
end

defn isFields()
  on("form.html", defn (p, site)
    held(id) = browser.Eval("document.getElementById('$id').value", p)?
    browser.Type("#email", "x@y.z", p)?
    browser.Type("#count", "7", p)?
    browser.Type("#notes", "two\nlines", p)?
    browser.Type("#rich", "plain", p)?
    browser.Type("#name", "", p)?
    list.All([
      held("email") == "x@y.z",
      held("count") == "7",
      held("notes") == "two\nlines",
      browser.Text("#rich", p)? == "plain",
      held("name") == ""])
  end)
end

defn isKeys()
  on("form.html", defn (p, site)
    browser.Click("#keys", p)?
    for combo in ["a", "Enter", "ArrowDown", "Control+a", "Control++", "+", "Shift+Tab"]
      browser.Press(combo, p)?
    end
    list.All([
      browser.Text("#pressed", p)? == "a Enter ArrowDown ctrl+a ctrl++ + shift+Tab",
      text.Contains("is no key", panicOf(() -> browser.Press("Enterr", p))),
      text.Contains("is no modifier", panicOf(() -> browser.Press("Ctrl+a", p))),
      text.Contains("is no key", panicOf(() -> browser.Press("Control+", p)))])
  end)
end

defn isScrolled()
  on("long.html", defn (p, site)
    browser.Click("#far", p)?
    browser.Text("#said", p)? == "far clicked"
  end)
end

defn isAcrossNavigation()
  on("away.html", defn (p, site)
    browser.Text("#target", p)? == "the new page"
  end)
end

defn navSite(posts)
  (** tests/pages, and the answers that nav.html leads to: /next answers a form after 0.2 s, then sends its body to
      posts; /later answers a page after 0.2 s; /nothing has no content (204); /attach is a download; /slow answers
      after 2 s. *)
  l = net.Listen(0)?
  page(here) = http.Html("<!doctype html><title>Next</title><p id=\"here\">$here</p><a id=\"again\" href=\"/nav.html\">Again</a><button id=\"back\" onclick=\"history.back()\">Back</button>")
  posted = defn (r)
    sys.Sleep(0.2)
    fiber.Send(r.Body, posts)
    page("posted $(r.Body)")
  end
  later = defn (r)
    sys.Sleep(0.2)
    page("the new page")
  end
  attach = {Status: 200, Body: "a,b\n", Headers: [{Name: "content-type", Value: "text/csv"}, {Name: "content-disposition", Value: "attachment; filename=a.csv"}]}
  fiber.Spawn(() -> http.Serve(http.App() then http.Post("/next", posted) then http.Get("/later", later) then http.Get("/nothing", r -> {Status: 204, Body: ""}) then http.Get("/attach", r -> attach) then http.Get("/slow", r -> slowly()) then http.Static("/", "tests/pages"), listener = l))
  result.Ok("http://127.0.0.1:$(net.Port(l))")
end

defn isNavigationWaited()
  (** A click or a key that takes the page to another document, by a link, a form, a script of the page or the
      history, answers once that document has loaded: the server has answered, and the next step reads the new page,
      never the one that went away, nor waits in it for ever. A click in a frame that loads the page around it holds
      the next step on that page. A click that loads nothing, or a navigation that brings no document, an answer 204,
      a download or a stop, holds nothing, nor does a Go to an answer 204, which fails; one that doesn't load in time
      is a timeout that names it. *)
  posts = fiber.Channel(size = 16)
  site = navSite(posts)?
  here = "document.getElementById('here').textContent"
  browser.Firefox(defn (b)
    p = browser.NewPage(b)?
    blank = browser.Eval("location.href", p)?
    home() = browser.Go("$site/nav.html", p)
    home()?
    browser.Click("#post", p)?
    heard = fiber.Receive(posts, timeout = 0)
    posted = [browser.Eval("location.pathname", p)?, browser.Eval("new Promise((done) => setTimeout(() => done(document.title), 10))", p)?, browser.Text("#here", p)?]
    home()?
    browser.Click("#later", p)?
    later = browser.Eval(here, p)?
    home()?
    browser.Click("#field", p)?
    browser.Press("Enter", p)?
    entered = [fiber.Receive(posts, timeout = 0).Value, browser.Eval("document.title", p)?]
    home()?
    _ = browser.Eval("document.getElementById('stop').onclick = () => document.forms[0].submit(), 1", p)?
    browser.Click("#stop", p)?
    submitted = browser.Eval(here, p)?
    browser.Click(browser.ByRole("link", name = "Again"), p)?
    again = browser.Eval("document.title", p)?
    browser.Click("#later", p)?
    browser.Click("#back", p)?
    back = browser.Eval(here, p)?
    browser.Click("#top", browser.Frame("#inner", p)?)?
    top = browser.Eval(here, p)?
    home()?
    slow = [browser.Click("#slow", p, timeout = 0.3).Error.Message, browser.Eval("1", p, timeout = 0.3).Error.Message, browser.Text("#here", p, timeout = 0.3).Error.Message]
    home()?
    t = sys.Now()
    for quick in ["#nothing", "#export", "#attach", "#idle", "#stop"]
      browser.Click(quick, p)?
    end
    none = [browser.Eval(here, p)?, sys.Now() - t < 1]
    went = browser.Go("$site/nothing", p)
    t = sys.Now()
    nothing = [went.Error.Kind, browser.Eval(here, p)?, sys.Now() - t < 1]
    list.All([
      blank == "about:blank",
      value.Equal(heard, result.Ok("n=x")),
      value.Equal(posted, ["/next", "Next", "posted n=x"]),
      later == "the new page",
      value.Equal(entered, ["n=x", "Next"]),
      submitted == "posted n=x",
      again == "Nav",
      back == "the first page",
      top == "the new page",
      value.Equal(none, ["the first page", true]),
      value.Equal(nothing, ["browser", "the first page", true]),
      value.Equal(slow, ["#slow: the page was still loading $site/slow after 0.3 s", "Eval: the page was still loading $site/slow after 0.3 s", "#here: the page was still loading $site/slow after 0.3 s"])])
  end, kept)
end

defn isPromptsDismissed()
  on("alert.html", defn (p, site)
    browser.Click("#alert", p)?
    first = browser.Text("#said", p)?
    browser.Click("#confirm", p)?
    first == "after the alert" and browser.Text("#said", p)? == "confirmed: false"
  end)
end

defn isEval()
  on("form.html", defn (p, site)
    list.All([
      value.Equal(browser.Eval("({a: 1, b: [1.5, 'x', null, undefined, true], d: new Date(0), n: NaN, z: -0})", p)?, {a: 1, b: [1.5, "x", missing, missing, true], d: "1970-01-01T00:00:00.000Z", n: missing, z: 0}),
      browser.Eval("new Promise((done) => setTimeout(() => done('late'), 50))", p)? == "late",
      browser.Eval("undefined", p)? == missing,
      value.Equal(browser.Eval("throw new TypeError('bad')", p).Error, {Kind: "script", Message: "TypeError: bad"}),
      kindOf(browser.Eval("() => 1", p)) == "script",
      kindOf(browser.Eval("document.body", p)) == "script",
      browser.Eval("new Promise(() => {})", p, timeout = 0.2).Error.Message == "Eval: no value after 0.2 s",
      value.Equal(browser.Eval("[[[[1]]]]", p)?, [[[[1]]]]),
      text.Contains("deeper than 64 levels", browser.Eval("(() => { let a = []; for (let i = 0; i < 5000; i++) a = [a]; return a; })()", p).Error.Message)])
  end)
end

defn isScreenshot()
  on("long.html", defn (p, site)
    png = text.FromBytes([137, 80, 78, 71, 13, 10, 26, 10])
    shot = browser.Screenshot(p)?
    whole = browser.Screenshot(p, full = true)?
    height(image) = list.Reduce((n, b) -> n * 256 + b, 0, text.Bytes(text.ByteSlice(21, 24, image)))
    list.All([text.StartsWith(png, shot), text.StartsWith(png, whole), height(shot) < 1000, height(whole) > 5000])
  end)
end

defn isPagesApart()
  site = served()?
  browser.Firefox(defn (b)
    pages = [browser.NewPage(b)? for k in 1..3]
    for p in pages
      browser.Go("$site/form.html", p)?
    end
    _ = browser.Eval("document.cookie = 'k=1'; localStorage.setItem('k', '1')", pages[1])?
    seen = fiber.Pmap(p -> [browser.Eval("document.visibilityState", p)?, browser.Eval("document.cookie", p)?, browser.Eval("localStorage.getItem('k')", p)?], pages)
    browser.ClosePage(pages[2])?
    list.All([
      value.Equal(seen, [["visible", "k=1", "1"], ["visible", "", missing], ["visible", "", missing]]),
      browser.ClosePage(pages[2]).Error.Kind == "browser",
      browser.Text("h1", pages[3])? == "Form"])
  end, kept)
end

defn slowly()
  sys.Sleep(2)
  {Status: 200, Body: "late"}
end

defn isErrors()
  l = net.Listen(0)?
  fiber.Spawn(() -> http.Serve(http.App() then http.Get("/slow", r -> slowly()), listener = l))
  slow = "http://127.0.0.1:$(net.Port(l))/slow"
  run = browser.Firefox(defn (b)
    p = browser.NewPage(b)?
    refused = browser.Go("http://127.0.0.1:1/", p)
    late = browser.Go(slow, p, timeout = 0.3)
    result.Ok({Browser: b, Page: p, Refused: refused, Late: late})
  end, kept)?
  list.All([
    run.Late.Error.Message == "$slow: not loaded after 0.3 s",
    run.Refused.Error.Kind == "browser",
    run.Refused.Error.Code == "unknown error",
    browser.Text("h1", run.Page).Error.Kind == "closed",
    browser.NewPage(run.Browser).Error.Kind == "closed"])
end

defn isFileUrlsKeepRead()
  (** Go keeps the rights of the program: a file: URL of a file that the program may not read, in each way Firefox
      reads one, its scheme in capitals, a space before it, a tab in it, the host localhost, one slash, a .., or inside
      view-source: or jar:, stops the program with Cesia's message, as sys.Read would; one that Ceti can't read as
      Firefox does, another host or %XX of a dot or a slash, is an Err; a file the program may read opens, in any of
      those ways. Firefox reads every one of them, so a Go that only passed the URL on read the file. The local page
      that opened is an origin of its own: a script of it can't fetch another file, which WebDriver BiDi lets it do. *)
  page = path.Abs("tests/pages/form.html")
  secret = "/etc/passwd"
  denied = ["file://$secret", "FILE://$secret", " file://$secret", "fi\tle://$secret", "file://localhost$secret", "file:$secret", "file:///tmp/..$secret", "view-source:file://$secret", "jar:file://$secret!/x"]
  odd = ["file://127.0.0.1$secret", "file:///tmp/%2e%2e$secret", "file:///tmp/..%2F$(text.Slice(2, value.Len(secret), secret))", "file:///tmp\\..$secret"]
  browser.Firefox(defn (b)
    p = browser.NewPage(b)?
    opened = []
    for u in ["file://$page", "FILE://localhost$page", " file:$page"]
      browser.Go(u, p)?
      opened = list.Append(browser.Text("h1", p)?, opened)
    end
    stopped = [says("denied for $secret", panicOf(() -> browser.Go(u, p))) for u in denied]
    refused = [browser.Go(u, p).Error.Kind for u in odd]
    fetched = browser.Eval("fetch('file://$secret').then(() => 'read', () => 'refused')", p)?
    list.All([
      value.Equal(opened, ["Form", "Form", "Form"]),
      list.All(stopped),
      value.Equal(refused, ["browser", "browser", "browser", "browser"]),
      fetched == "refused",
      browser.Eval("location.href", p)? == "file://$page"])
  end, kept)
end

defn isProfilesPrivate()
  (** The folder given to Firefox, its template, each profile and the folder where a download waits are their owner's
      alone, 0700, and the files that Ceti copies or writes in a profile 0600, as Firefox makes its keys and its
      certificates: no one else on the machine reads the cookies or the storage of a page while Firefox runs. They were
      0755 and 0644, key4.db and cert9.db too. *)
  site = served()?
  alone = 448   (* 0700 *)
  own = 384   (* 0600 *)
  mode(f) = sys.Stat(f).Value.Mode
  waiting = fiber.Channel(size = 1)
  browser.Firefox(defn (b)
    profile = "$kept/$(others(kept)?[1])"
    p = browser.NewPage(b)?
    browser.Go("$site/events.html", p)?
    export = defn ()
      fiber.Send([mode("$profile/$name") for name in sys.List(profile)? if text.StartsWith("downloads-", name)], waiting)
      browser.Click(browser.ByRole("link", name = "Export"), p)
    end
    browser.Download(export, "$(test.Temp())/report.csv", p)?
    list.All([
      value.Equal([mode(f) for f in [kept, "$kept/$templateName", profile, "$profile/storage"]], [alone, alone, alone, alone]),
      value.Equal([mode("$profile/$f") for f in ["user.js", "key4.db", "cert9.db", "cookies.sqlite"]], [own, own, own, own]),
      value.Equal(fiber.Receive(waiting, timeout = 0)?, [alone])])
  end, kept)
end

defn isPanicCloses()
  message = panicOf(() -> browser.Firefox(b -> bug.Panic("on purpose"), kept))
  text.Contains("on purpose", message) and value.Len(others(kept)?) == 0
end

defn isCancelCloses()
  (** A caller that fiber.Cancel stops leaves no Firefox and no profile behind, while the program runs: f is cancelled,
      then Firefox is closed and its profile removed within a few seconds. f ran on before, and Firefox with it, for as
      long as f wanted, and for good when the program ended meanwhile. *)
  ready = fiber.Channel()
  went = fiber.Channel()
  t = fiber.Spawn(() -> browser.Firefox(defn (b)
    fiber.Send(true, ready)
    sys.Sleep(25)
    fiber.Send("f ran on", went)
  end, kept))
  fiber.Receive(ready, timeout = 20)?
  fiber.Cancel(t)
  stopped = fiber.Wait(t).Error.Kind == "cancelled"
  n = 0
  while value.Len(others(kept)?) > 0 and n < 100
    sys.Sleep(0.1)
    n += 1
  end
  list.All([stopped, value.Len(others(kept)?) == 0, fiber.Receive(went, timeout = 0).Error.Kind == "timeout"])
end

defn isErrGivenBack()
  value.Equal(browser.Firefox(b -> result.Err("mine"), kept), result.Err("mine")) and value.Len(others(kept)?) == 0
end

(* What a run writes and keeps: a cookie of an hour, localStorage, an IndexedDB database. *)
writes = "document.cookie = 'kept=1; max-age=3600'; localStorage.setItem('kept', '1'); new Promise((done) => { const r = indexedDB.open('kept', 1); r.onupgradeneeded = () => r.result.createObjectStore('s'); r.onsuccess = () => { const t = r.result.transaction('s', 'readwrite'); t.objectStore('s').put(1, 'k'); t.oncomplete = () => { r.result.close(); done(true); }; }; })"

(* What a page sees of them, and the text of /cached, which the HTTP cache may keep for an hour. *)
seen = "Promise.all([document.cookie, localStorage.getItem('kept'), indexedDB.databases().then((d) => d.map((x) => x.name)), fetch('/cached').then((r) => r.text())])"

defn cached(hits)
  (** A text that the browser may keep in its HTTP cache for an hour; each request for it sends 1 on hits. *)
  fiber.Send(1, hits)
  http.WithHeader("cache-control", "max-age=3600", http.Plain("cached"))
end

defn drained(hits)
  (** How many requests reached /cached since the last count. *)
  n = 0
  while result.IsOk(fiber.Receive(hits, timeout = 0))
    n += 1
  end
  n
end

defn fingerprints(dir)
  (** Each file of a folder, at any depth, beside the fingerprint of its bytes, or "link" for a link. *)
  out = []
  for p in sys.Walk(dir)?
    s = sys.Stat(p)
    out = list.Append([p, if result.IsErr(s) or s.Value.IsLink "link" else cesia.Fingerprint(sys.Read(p)?) end], out)
  end
  result.Ok(out)
end

defn isRunsForget()
  (** A run that writes a cookie, localStorage, IndexedDB and the HTTP cache, then a next run in the same kept folder,
      on the same origin: the next one sees none of them and asks the server again, and the template is the same, file
      for file and byte for byte, with no profile left beside it. The first run sees what it wrote, and its HTTP cache
      answers the second fetch. A page can't see what another run kept, as each page has a user context of its own: a
      Ceti that ran on the template itself, or made each run's profile the next template, passes the page checks and
      fails the fingerprints. *)
  hits = fiber.Channel(size = 100)
  l = net.Listen(0)?
  fiber.Spawn(() -> http.Serve(http.App() then http.Get("/cached", r -> cached(hits)) then http.Static("/", "tests/pages"), listener = l))
  site = "http://127.0.0.1:$(net.Port(l))"
  model = "$kept/$templateName"
  if not sys.Exists(model)
    browser.Firefox(b -> result.Ok(missing), kept)?
  end
  before = fingerprints(model)?
  look(f) = browser.Firefox(defn (b)
    p = browser.NewPage(b)?
    browser.Go("$site/form.html", p)?
    f(p)
  end, kept)
  first = look(defn (p)
    _ = browser.Eval(writes, p)?
    result.Ok([browser.Eval(seen, p)?, browser.Eval(seen, p)?])
  end)?
  firstHits = drained(hits)
  next = look(p -> browser.Eval(seen, p))?
  list.All([
    value.Equal(first, [["kept=1", "1", ["kept"], "cached"], ["kept=1", "1", ["kept"], "cached"]]),
    firstHits == 1,
    value.Equal(next, ["", missing, [], "cached"]),
    drained(hits) == 1,
    value.Equal(fingerprints(model)?, before),
    value.Equal(others(kept)?, [])])
end

defn isOneTemplatePerVersion()
  (** Two Firefoxes that start at once in a folder that holds the template of another version: both run, one template of
      this version stays, named by firefox --full-version, and the other version's goes. *)
  dir = test.Temp()
  sys.Mkdir("$dir/template-1.0-1")?
  sys.Write("$dir/template-1.0-1/prefs.js", "")?
  ran = fiber.Pmap(k -> browser.Firefox(b -> result.Ok(k), dir), [1, 2])
  value.Equal(ran, [result.Ok(1), result.Ok(2)]) and value.Equal(sys.List(dir)?, [templateName])
end

defn current()
  (** The fingerprints of the files of the template of this version of Firefox in the kept folder, or missing. *)
  files = if sys.Exists("$kept/$templateName") fingerprints("$kept/$templateName") else result.Err("none") end
  if result.IsOk(files) files.Value else missing end
end

(* The template of this version as the tests of this file found it, when there was one: the last test compares it with
   what they left. After an update of Firefox there is none yet. *)
found = current()

defn isTemplateUnchangedByTheTests()
  (** The last test of this file: of all the runs of the tests before it, in the kept folder, none changed the template,
      file for file and byte for byte; when there was none for this version at the start, the first run made it, and it
      is there. *)
  now = current()
  not value.IsMissing(now) and (value.IsMissing(found) or value.Equal(now, found))
end
