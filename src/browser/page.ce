(* The pages of a browser: open, go, find, click, type, read, run JavaScript, capture. *)
use std/encode
use std/json
use std/bug
use std/dict
use std/fiber
use std/list
use std/math
use std/result
use std/sys
use std/text
use std/value

(** How long Click, Type, Text, WaitFor, Go and Eval wait by default, in seconds. Each of them takes timeout = to wait
    longer or less.

      DefaultTimeout --> 5 *)
DefaultTimeout = 5

(* A page: a browsing context and its user context. kind is "page" for a top-level one that owns its user context,
   "tab" for one that shares it, "frame" for a frame. home is the tab Firefox opened at its start when this page opened
   beside it, else missing. *)
struct page { context, userContext, home, session, kind }

(* The margin, in seconds, that a wait in the page has before Cesia stops waiting for its answer. *)
margin = 1

defn NewPage(b, state = missing)
  (** Opens a page in a user context of its own, as a private window has: its cookies and its storage are its own,
      unseen by the other pages and unseeing theirs. It is visible, as a page that a person looks at, whatever other
      pages are open, so that its timers and its frames run at full speed. With state, what State gave, as after a
      sign-in, its user context starts with those cookies and that localStorage, and the page is on about:blank. An Ok
      of the page, or an Err. *)
  uc = call("browser.createUserContext", {}, b)?.userContext
  beside = fiber.Receive(b.home, timeout = 0)
  params = if result.IsOk(beside) {type: "tab", userContext: uc, referenceContext: beside.Value} else {type: "window", userContext: uc} end
  made = call("browsingContext.create", params, b)
  if result.IsErr(made)
    if result.IsOk(beside)
      fiber.Send(beside.Value, b.home)
    end
    _ = call("browser.removeUserContext", {userContext: uc}, b)
    return made
  end
  p = page(made.Value.context, uc, if result.IsOk(beside) beside.Value else missing end, b, "page")
  given = if value.IsMissing(state) result.Ok(missing) else restore(state, p) end
  if result.IsErr(given)
    _ = ClosePage(p)
    return given
  end
  result.Ok(p)
end

defn ClosePage(p)
  (** Closes a page and its user context, with its tabs and popups; a tab or a popup alone: Ok(missing), or an Err. A
      program that opens many pages closes each one; the pages that are still open close with the browser. A frame
      closes with its page, so ClosePage of one is a bug: it panics. *)
  if p.kind == "frame"
    bug.Panic("ClosePage closes a page, a tab or a popup, not a frame: a frame closes with its page.")
  end
  if p.kind == "tab"
    call("browsingContext.close", {context: p.context}, p.session)?
    return result.Ok(missing)
  end
  call("browser.removeUserContext", {userContext: p.userContext}, p.session)?
  tell({Forget: p.userContext}, p.session)
  if not value.IsMissing(p.home)
    fiber.Send(p.home, p.session.home)
  end
  result.Ok(missing)
end

defn Frame(selector, p, timeout = DefaultTimeout)
  (** The frame of the first iframe or frame of a selector, once it is there, shown or not, as a page: every function
      of a page works in it, its own origin or another. It closes with its page. An Ok of it, or an Err of the kind
      "timeout"; an element that is no frame is a bug, so it panics. *)
  got = seek(selector, "frame", p, timeout)?
  result.Ok(page(got.value.context, p.userContext, missing, p.session, "frame"))
end

defn Go(url, p, timeout = DefaultTimeout)
  (** Goes to a URL and waits for its load event, at most timeout seconds: Ok(missing), an Err of the kind "browser"
      when the page can't be loaded, or of the kind "timeout". *)
  went = call("browsingContext.navigate", {context: p.context, url: url, wait: "complete"}, p.session, wait = timeout)
  if result.IsOk(went) or went.Error.Kind == "browser"
    (* Over, with its document or none: a navigation to an answer 204 fails with NS_BINDING_ABORTED, and no event of
       browsingContext tells of its end. *)
    tell({Ended: p.context, Navigation: if result.IsOk(went) and value.IsDict(went.Value) dict.GetOr("navigation", missing, went.Value) else missing end}, p.session)
  end
  late(went, "$url: not loaded after $timeout s")?
  result.Ok(missing)
end

defn Click(selector, p, timeout = DefaultTimeout)
  (** Waits for the first element of a selector, a CSS text or a locator as ByRole, that is visible and not disabled,
      scrolls it into view, and clicks its centre with the mouse: the events are the browser's own, as a person's click
      makes them. When the click takes the page to another document, as a link or the button of a form does, it
      answers once that document has loaded, as Go does, so that what comes next, a step or a look at the server's
      data, sees the page that the click led to; a click that loads nothing answers at once. All within timeout:
      Ok(missing), or an Err of the kind "timeout" that says what it waited for. *)
  until = sys.Now() + timeout
  press(seek(selector, "click", p, timeout)?, p, says(selector), timeout, until)
end

(* A click at the centre of an element in view, then the wait for the page it leads to, if it leads to one. *)
press(node, p, what, timeout, until) = act([mouse([toward(node, 0), {type: "pointerDown", button: 0}, {type: "pointerUp", button: 0}])], p, what, timeout, until, arm = true)

(* The mouse's move to the centre of an element in view, in duration milliseconds. *)
toward(node, duration) = {type: "pointerMove", x: 0, y: 0, duration: duration, origin: {type: "element", element: {sharedId: node.sharedId}}}

mouse(moves) = {type: "pointer", id: "mouse", parameters: {pointerType: "mouse"}, actions: moves}   (* A mouse source. *)

defn Type(selector, words, p, timeout = DefaultTimeout)
  (** Waits for the first field of a selector that is visible, enabled and not read-only, gives it the focus, selects
      what it holds, then types the text key by key: the field then holds the text. An input, a textarea or an element
      that is contentEditable is a field. An input of a type that takes no keys, as date, time, datetime-local, month,
      week, color or range, gets the text as its value, written as HTML writes it ("2026-03-15", "09:30", "#ff0000"),
      with the events input and change. Ok(missing), or an Err of the kind "timeout". *)
  until = sys.Now() + timeout
  if dict.Has("set", seek(selector, "type", p, timeout, arg = words)?)
    return result.Ok(missing)
  end
  keys = if words == "" [{type: "keyDown", value: key("Backspace")}, {type: "keyUp", value: key("Backspace")}] else typing(words) end
  act([{type: "key", id: "keyboard", actions: keys}], p, says(selector), timeout, until)
end

defn Press(combo, p)
  (** Presses a key in the element that has the focus: one character, as "a", or a key by its name, as "Enter", "Tab",
      "Escape", "Backspace", "ArrowDown" or "F5", after its modifiers, as "Control+A" or "Shift+Tab". A key that takes
      the page to another document, as Enter in a form, waits for it as Click does, within DefaultTimeout. Ok(missing),
      or an Err. A name that is no key is a bug, so it panics with the names. *)
  keys = chord(combo)
  until = sys.Now() + DefaultTimeout
  landed(p, "Press", DefaultTimeout, until = until)?
  act([{type: "key", id: "keyboard", actions: keys}], p, "Press", DefaultTimeout, until, arm = true)
end

defn Text(selector, p, timeout = DefaultTimeout)
  (** The visible text, innerText, of the first visible element of a selector, once there is one: an Ok of the text,
      or an Err of the kind "timeout". *)
  found = seek(selector, "text", p, timeout)?
  result.Ok(found.text)
end

defn Texts(selector, p)
  (** The innerText of every element of a selector, as they are now, with no wait for them, once the navigation under
      way, if one is, has loaded its document: an Ok of the list, which is empty when none matches, or an Err. An
      element that isn't shown, as one in display: none, gives its text as the source holds it. *)
  landed(p, says(selector), DefaultTimeout)?
  got = finder([json.Text(selector), "texts", 0, ""], p, answerTime)?
  if got.type == "object"
    bug.Panic("$(says(selector)) is no CSS selector: $(fromRemote(got)?.bad)")
  end
  fromRemote(got)
end

defn Value(selector, p, timeout = DefaultTimeout)
  (** What the first field of a selector holds, once there is one, shown or not: the text of an input or a textarea,
      true or false for a checkbox or a radio, the label of the chosen option of a select, or a list of them for a
      select that takes several. An Ok of it, or an Err of the kind "timeout". *)
  result.Ok(seek(selector, "value", p, timeout)?.value)
end

defn Eval(js, p, timeout = DefaultTimeout)
  (** The value of a JavaScript expression in the page, its promise awaited, at most timeout seconds: an Ok of the value
      as JSON writes it, a number, a text, true or false, a list, a dictionary, or missing for null and undefined; a date
      as its text, NaN and the infinities as missing. Another value, as a function, an element or a Map, is an Err of the
      kind "script" that names it: turn it into one of those in the expression; so is a value that nests deeper than 64
      levels. An exception is an Err of the kind "script" with its message. It runs once the navigation under way, if
      one is, as after a click on a link, has loaded its document, within the same timeout. *)
  until = sys.Now() + timeout
  landed(p, "Eval", timeout, until = until)?
  got = late(call("script.evaluate", {expression: js, target: {context: p.context}, awaitPromise: true, serializationOptions: {maxObjectDepth: maxDepth}}, p.session, wait = left(until)), "Eval: no value after $timeout s")?
  if got.type == "exception"
    return result.Err({Kind: "script", Message: got.exceptionDetails.text})
  end
  fromRemote(got.result)
end

defn Screenshot(p, full = false, of = missing, timeout = DefaultTimeout)
  (** The bytes of a PNG image of what the page shows in its viewport, or of the whole page with full = true, or, with
      of a selector, of its first visible element alone, wherever it is in the page, once there is one: an Ok of a text
      of bytes, which sys.Write saves as it is, or an Err. *)
  if value.IsMissing(of)
    landed(p, "Screenshot", timeout)?
  end
  params = {context: p.context, origin: if full or not value.IsMissing(of) "document" else "viewport" end}
  params = if value.IsMissing(of) params else dict.Put("clip", {type: "element", element: {sharedId: seek(of, "node", p, timeout)?.sharedId}}, params) end
  shot = call("browsingContext.captureScreenshot", params, p.session)?
  encode.Unbase64(shot.data)
end

defn Pdf(p)
  (** The bytes of a PDF of the page, as it prints on paper of the US Letter size with margins of 1 cm, BiDi's
      defaults: an Ok of a text of bytes, which sys.Write saves as it is, or an Err. Firefox takes about 2.6 s to print
      a page. *)
  landed(p, "Pdf", DefaultTimeout)?
  printed = call("browsingContext.print", {context: p.context}, p.session)?
  encode.Unbase64(printed.data)
end

defn WaitFor(selector, p, timeout = DefaultTimeout)
  (** Waits until an element of a selector is visible, at most timeout seconds: Ok(missing), or an Err of the kind
      "timeout". *)
  seek(selector, "show", p, timeout)?
  result.Ok(missing)
end

(* The seconds left before until, or 0 once it has passed. *)
left(until) = if until > sys.Now() until - sys.Now() else 0 end

defn landed(p, what, timeout, until = missing)
  (** Waits until the navigation under way in p, if one is, has ended, as after a click on a link or the button of a
      form: its document has loaded, or it brings none, as a download, an answer 204 or a navigation that failed or was
      stopped. It waits until until, or timeout seconds when until is missing: Ok(missing), an Err of the kind "timeout"
      that begins with what and names the page still loading after timeout seconds, or of the kind "closed". So a step
      never runs in a document that is going away. *)
  if isClosed(p.session.gone)
    return lost()
  end
  reply = fiber.Channel(size = 2)
  fiber.Send({Settle: p.context, Reply: reply}, p.session.requests)
  first = fiber.Receive(reply, timeout = answerTime)
  url = if result.IsOk(first) first.Value? else lost()? end
  if value.IsMissing(url)
    return result.Ok(missing)
  end
  ended = fiber.Receive(reply, timeout = if value.IsMissing(until) timeout else left(until) end)
  if result.IsErr(ended)
    return result.Err({Kind: "timeout", Message: "$what: the page was still loading $url after $timeout s"})
  end
  ended.Value
end

(* A timeout of the answer, said as the wait it was. *)
late(r, message) = if result.IsErr(r) and r.Error.Kind == "timeout" result.Err({Kind: "timeout", Message: message}) else r end

defn act(sources, p, what, timeout, until, arm = false)
  (** Performs input actions, then waits until until for the navigation that they started, if they did: Firefox tells
      of it, browsingContext.navigationStarted, before it answers the actions. Ok(missing), or an Err that begins with
      what. A navigation that brings no document, an answer 204 or a stop, sends no event of browsingContext, only
      network.fetchError. So with arm, for a click or a key press, the actions that lead to such pages, a subscription
      to it for the page's tab goes just before the actions, sent ahead: Firefox 160 applies it as it reads it, before
      it reads the actions. The dispatcher ends it once the navigation has its document or has ended, or at once when
      none began, since while it lasts Firefox follows every request of the tab, at about 1 ms each. *)
  armed = if arm ahead("session.subscribe", {events: ["network.fetchError"], contexts: [p.context]}, p.session) else missing end
  acted = call("input.performActions", {context: p.context, actions: sources}, p.session)
  if arm
    sub = answerOf(armed)
    id = if result.IsOk(sub) and value.IsDict(sub.Value) dict.GetOr("subscription", missing, sub.Value) else missing end
    if value.IsText(id)
      tell({Disarm: id, After: p.context}, p.session)
    end
  end
  acted?
  landed(p, what, timeout, until = until)
end

defn callFunction(js, args, p, wait)
  (** Calls a function of JavaScript in Ceti's sandbox of the page with texts and numbers, its promise awaited: an Ok of
      its value as BiDi gives it, a remote value, or an Err. A JavaScript exception is a bug of this package, so it
      panics. *)
  locals = [if value.IsText(a) {type: "string", value: a} else {type: "number", value: a} end for a in args]
  got = call("script.callFunction", {functionDeclaration: js, arguments: locals, target: {context: p.context, sandbox: "ceti"}, awaitPromise: true}, p.session, wait = wait)?
  if got.type == "exception"
    bug.Panic("The JavaScript of ceti failed: $(got.exceptionDetails.text)")
  end
  result.Ok(got.result)
end

defn finder(args, p, wait)
  (** Calls the finder of the page's document with args: its remote value. The first call in a document finds no
      finder in its sandbox, so Ceti puts it there, once: a preload script would do it for each document, at a cost
      of 2.7 ms for each Go, measured, where most documents need it once. *)
  got = callFunction(finderJs, args, p, wait)?
  if got.type != "undefined"
    return result.Ok(got)
  end
  callFunction(installJs, [], p, answerTime)?
  callFunction(finderJs, args, p, wait)
end

defn seek(selector, mode, p, timeout, arg = "")
  (** Runs the finder until it finds its element, at most timeout seconds, once the navigation under way in the page,
      if one is, has brought its document, and again in the new document when the page goes away: an Ok of what it
      gave, or an Err of the kind "timeout" that says what it saw. *)
  until = sys.Now() + timeout
  q = json.Text(selector)
  while true
    landed(p, says(selector), timeout, until = until)?
    rest = left(until)
    got = finder([q, mode, math.Round(rest * 1000), arg], p, rest + margin)?
    if got.type == "node" or got.type == "window"
      return result.Ok(got)
    end
    seen = fromRemote(got)?
    if dict.Has("bad", seen)
      bug.Panic("$(says(selector)) is no CSS selector: $(seen.bad)")
    else if dict.Has("bug", seen)
      bug.Panic("The first element of $(says(selector)) $(seen.bug).")
    else if dict.Has("field", seen)
      bug.Panic("Type: the first visible element of $(says(selector)) is no field: an input, a textarea or a contentEditable element.")
    else if dict.Has("late", seen)
      return result.Err({Kind: "timeout", Message: "$(says(selector)): $(lateness(seen, mode)) after $timeout s"})
    else if not dict.Has("left", seen)
      return result.Ok(seen)
    end
    if sys.Now() >= until
      return result.Err({Kind: "timeout", Message: "$(says(selector)): the page went away and none came back after $timeout s"})
    end
  end
end

defn lateness(seen, mode)
  (** What a wait saw at its end, in words. *)
  if seen.found == 0
    "no element matches"
  else if seen.why != ""
    seen.why
  else if seen.shown == 0
    "no visible element ($(seen.found) match, none visible)"
  else if mode == "type"
    "no visible field that is enabled and not read-only ($(seen.shown) visible)"
  else
    "no visible element that is enabled ($(seen.shown) visible, all disabled)"
  end
end

defn fromRemote(v)
  (** A remote value of BiDi (§6.3 of the spec: its type, and its value) as JSON would give it: an Ok, or an Err of the
      kind "script" for a value that JSON can't write. *)
  match v.type
    "undefined" -> result.Ok(missing)
    "null" -> result.Ok(missing)
    "string" -> result.Ok(v.value)
    "boolean" -> result.Ok(v.value)
    "date" -> result.Ok(v.value)
    "number" -> result.Ok(if value.IsText(v.value) (if v.value == "-0" 0 else missing end) else v.value end)
    "array" -> if dict.Has("value", v) items(v.value) else cycle() end
    "object" -> if dict.Has("value", v) entries(v.value) else cycle() end
    else -> result.Err({Kind: "script", Message: "Eval gives what JSON can write, and this is a $(v.type): turn it into a number, a text, a list or an object in the expression."})
  end
end

cycle() = result.Err({Kind: "script", Message: "Eval gives what JSON can write, and this object holds itself, or nests deeper than $maxDepth levels."})

(* How deep a value of Eval may nest: Firefox writes no deeper, so that no message is too deep to read. *)
maxDepth = 64

defn items(values)
  (** The values of a remote array, as a list. *)
  out = []
  for v in values
    out = list.Append(fromRemote(v)?, out)
  end
  result.Ok(out)
end

defn entries(pairs)
  (** The pairs of a remote object, [key, value], as a dictionary. *)
  d = dict.Dict()
  for pair in pairs
    d[pair[1]] = fromRemote(pair[2])?
  end
  result.Ok(d)
end
