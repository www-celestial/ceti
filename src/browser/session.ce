(* WebDriver BiDi on a WebSocket: each command is a JSON message with an id, and the browser answers each one with a
   message of the same id, of the type "success" or "error" (W3C WebDriver BiDi, §3 Protocol); events come without an
   id. One fiber, the dispatcher, owns the connection: it gives each request its id, writes it, hands each answer to the
   fiber that waits for it, so that several fibers can drive the browser at once, and hands each event to the watches
   that ask for it. *)
use std/websocket
use std/fiber
use std/json
use std/dict
use std/list
use std/math
use std/result
use std/sys
use std/text
use std/value

(* How long a command that doesn't wait on the page may take, in seconds, before Firefox is taken for stuck. *)
answerTime = 30

(* The connection as the pages use it: requests goes to the dispatcher, gone is closed once the connection has ended,
   home holds, while no page uses it, the tab Firefox opened at its start, beside which the first page opens, profile is
   the folder of the profile as Ceti gave it to Firefox, here the current folder, absolute, or missing when Ceti
   can't tell it, and slow the seconds Ceti waits before each action, so that a person can follow it (0: none). *)
struct session { requests, gone, home, dispatcher, profile, here, slow }

(* The commands that act on a page, as a person would: Firefox's slow = waits before each of them, and before no
   command that only reads, so that the waits of the locators, which ask again and again, keep their pace. *)
acting = ["browsingContext.navigate", "browsingContext.reload", "browsingContext.traverseHistory",
  "browsingContext.handleUserPrompt", "input.performActions", "input.setFiles"]

failure(kind, message) = result.Err({Kind: kind, Message: message})
lost() = failure("closed", "Firefox has closed.")
isClosed(ch) = fiber.Receive(ch, timeout = 0).Error.Kind == "closed"

(* The largest message of Firefox that Ceti reads, in bytes: 64 MiB, the DefaultMaxMessage of std/websocket. A larger
   one ends the connection, as the WebSocket can't skip a message. *)
maxMessage = websocket.DefaultMaxMessage

(* Why a session ended when a message of Firefox passed maxMessage: the steps after it say so. *)
tooBig = failure("closed", "Firefox sent a message of more than $(math.Div(maxMessage, 1048576)) MiB, the most Ceti reads, which ended the session: a page does it with a line of that size in its console, or a screenshot, a PDF or a value of Eval that large. Firefox ran on, and closes with the browser.")

defn whyEnded(s)
  (** Why a session has ended, once its dispatcher has said it: tooBig, or lost() for a Firefox that has closed. *)
  why = fiber.Wait(s.dispatcher, timeout = 0)
  if result.IsOk(why) and failed(why.Value) why.Value else lost() end
end

defn endedTooBig(s)
  (** Did a message of Firefox too large end the session, while Firefox ran? *)
  why = fiber.Wait(s.dispatcher, timeout = 0)
  result.IsOk(why) and value.Equal(why.Value, tooBig)
end

(* What the console keeps of each user context: its last entries, each cut to its first characters. *)
consoleEntries = 1000
entryLength = 16384

defn open(url)
  (** Connects to the BiDi server of Firefox at url and starts its dispatcher: an Ok of a session, or an Err. *)
  c = websocket.Dial(url, maxMessage = maxMessage)?
  requests = fiber.Channel()
  gone = fiber.Channel()
  result.Ok(session(requests, gone, fiber.Channel(size = 1), fiber.Spawn(() -> dispatch(c, requests, gone)), missing, missing, 0))
end

defn call(method, params, s, wait = answerTime)
  (** Sends a command and waits for its answer, at most wait seconds: an Ok of its result, an Err of the kind "browser"
      with the error's Code and Message, of the kind "closed" once the connection has ended, or of the kind "timeout".
      A command that acts on a page waits the session's slow seconds first. *)
  if isClosed(s.gone)
    return whyEnded(s)
  end
  if s.slow > 0 and method in acting
    sys.Sleep(s.slow)
  end
  reply = fiber.Channel(size = 1)
  fiber.Send({Method: method, Params: params, Reply: reply}, s.requests)
  got = fiber.Receive(reply, timeout = wait)
  if result.IsErr(got)
    return failure("timeout", "Firefox gave no answer to $method within $wait seconds.")
  end
  got.Value
end

defn ahead(method, params, s)
  (** Sends a command with no wait for its answer: the channel of the answer, which answerOf reads. The dispatcher
      writes the commands in the order they come, so a command sent ahead reaches Firefox before the next one. *)
  reply = fiber.Channel(size = 1)
  if isClosed(s.gone)
    fiber.Send(whyEnded(s), reply)
  else
    fiber.Send({Method: method, Params: params, Reply: reply}, s.requests)
  end
  reply
end

(* The answer of a command sent ahead, as call gives it, or the Err of the wait when none came within wait seconds. *)
answerOf(reply, wait = answerTime) = fiber.Receive(reply, timeout = wait)?

defn tell(r, s)
  (** Gives the dispatcher a request that has no answer, while it runs. *)
  if not isClosed(s.gone)
    fiber.Send(r, s.requests)
  end
end

defn ask(r, s)
  (** Sends the dispatcher a request of its own, as a watch, and gives its answer, or an Err of the kind "closed". *)
  if isClosed(s.gone)
    return whyEnded(s)
  end
  reply = fiber.Channel(size = 1)
  fiber.Send(dict.Put("Reply", reply, r), s.requests)
  got = fiber.Receive(reply, timeout = answerTime)
  if result.IsErr(got) whyEnded(s) else got.Value end
end

defn watch(methods, test, run, s, once = true, only = false)
  (** Asks the dispatcher to call run(params) in a fiber of its own for each event of one of the methods whose params
      pass test, a quick function that the dispatcher runs itself, which reads them with dict.GetOr; with once, for the
      first one only. Of the watches that are only, the last one given that takes an event has it, as the last route
      does a request. An Ok of the watch's number, for unwatch. *)
  ask({Watch: {Methods: methods, Test: test, Run: run, Once: once, Only: only}}, s)
end

unwatch(id, s) = tell({Unwatch: id}, s)   (* Ends a watch, if it hasn't ended. *)

defn hangUp(s)
  (** Stops the dispatcher, which closes the connection. *)
  if not isClosed(s.gone)
    fiber.Send({Stop: true}, s.requests)
  end
  _ = fiber.Wait(s.dispatcher)
end

defn dispatch(c, requests, gone)
  (** The fiber that owns the connection, until it ends or a Stop comes. A request gets the next id and is written; an
      answer goes to the request of its id, as an Ok of its result or an Err; an event goes to the watches that take it.
      A prompt that no watch takes is dismissed, and the console's entries are kept for each user context. It follows
      the navigation under way in each browsing context, holds each Settle until that navigation has ended, and ends
      the subscription of each Disarm once the navigation of its context has its document or has ended, or at once when
      none is under way. At the end, the requests that wait get an Err of the kind "closed", as do those that come
      after, which says why: tooBig when a message of Firefox passed maxMessage. It gives that Err, which whyEnded
      reads, or lost() after a Stop. *)
  s = {requests: requests, gone: gone}
  waiting = dict.Dict()
  watches = dict.Dict()
  logs = dict.Dict()
  going = dict.Dict()
  held = dict.Dict()
  armed = dict.Dict()
  next = 0
  why = lost()
  stopped = false
  while true
    got = fiber.Select([requests, c.Messages])
    if result.IsErr(got)
      (* The connection ended: Close tells how, before any step hears of it. *)
      how = websocket.Close(c)
      why = if result.IsErr(how) and text.StartsWith("1009:", how.Error.Message) tooBig else lost() end
      break
    end
    if got.Value.Channel == requests
      r = got.Value.Value
      if dict.Has("Stop", r)
        stopped = true
        break
      end
      next += 1
      if dict.Has("Watch", r)
        watches[next] = r.Watch
        fiber.Send(result.Ok(next), r.Reply)
      else if dict.Has("Unwatch", r)
        watches = dict.Drop(r.Unwatch, watches)
      else if dict.Has("Console", r)
        fiber.Send(result.Ok(dict.GetOr(r.Console, [], logs)), r.Reply)
      else if dict.Has("Forget", r)
        logs = dict.Drop(r.Forget, logs)
      else if dict.Has("Settle", r)
        if dict.Has(r.Settle, going)
          fiber.Send(result.Ok(going[r.Settle].Url), r.Reply)
          held[r.Settle] = list.Append(r.Reply, dict.GetOr(r.Settle, [], held))
        else
          fiber.Send(result.Ok(missing), r.Reply)
        end
      else if dict.Has("Disarm", r)
        ctx = r.After
        if dict.Has(ctx, going) and not going[ctx].Committed and value.Len(dict.GetOr(ctx, [], armed)) < maxArmed
          armed[ctx] = list.Append(r.Disarm, dict.GetOr(ctx, [], armed))
        else
          fiber.Spawn(() -> call("session.unsubscribe", {subscriptions: [r.Disarm]}, s))
        end
      else if dict.Has("Ended", r)
        if dict.Has(r.Ended, going) and (value.IsMissing(r.Navigation) or going[r.Ended].Navigation == r.Navigation)
          going = dict.Drop(r.Ended, going)
          held = released(r.Ended, held)
          armed = disarmed(r.Ended, armed, s)
        end
      else
        sent = websocket.Send(json.Text({id: next, method: r.Method, params: r.Params}), c)
        if result.IsOk(sent)
          waiting[next] = r.Reply
        else
          fiber.Send(lost(), r.Reply)
        end
      end
    else
      parsed = json.Parse(got.Value.Value)
      m = if result.IsOk(parsed) and value.IsDict(parsed.Value) parsed.Value else {} end
      id = dict.GetOr("id", missing, m)
      if value.IsNumber(id) and dict.Has(id, waiting)
        fiber.Send(answer(m), waiting[id])
        waiting = dict.Drop(id, waiting)
      else if dict.GetOr("type", "", m) == "event" and value.IsDict(dict.GetOr("params", missing, m))
        e = m.params
        method = dict.GetOr("method", "", m)
        moved = followed(going, method, e)
        going = moved.Going
        if not value.IsMissing(moved.Ended)
          held = released(moved.Ended, held)
        end
        if not value.IsMissing(moved.Landed)
          armed = disarmed(moved.Landed, armed, s)
        end
        taken = false
        owned = false
        for k in list.Reverse(list.Sort(dict.Keys(watches)))
          w = watches[k]
          if not (w.Only and owned) and method in w.Methods and w.Test(e)
            fiber.Spawn(() -> w.Run(e))
            taken = true
            owned = owned or w.Only
            if w.Once
              watches = dict.Drop(k, watches)
            end
          end
        end
        if method == "network.beforeRequestSent" and dict.GetOr("isBlocked", false, e) == true and not owned
          fiber.Spawn(() -> call("network.continueRequest", {request: dict.GetOr("request", "", requestOf(e))}, s))
        else if method == "log.entryAdded"
          source = dict.GetOr("source", {}, e)
          uc = if value.IsDict(source) dict.GetOr("userContext", "default", source) else "default" end
          uc = if value.IsText(uc) uc else "default" end
          logs[uc] = kept(list.Append(entry(e), dict.GetOr(uc, [], logs)))
        else if method == "browsingContext.userPromptOpened" and not taken
          fiber.Spawn(() -> call("browsingContext.handleUserPrompt", {context: dict.GetOr("context", "", e), accept: false}, s))
        end
      end
    end
  end
  for reply in dict.Values(waiting)
    fiber.Send(why, reply)
  end
  for replies in dict.Values(held)
    for reply in replies
      fiber.Send(why, reply)
    end
  end
  fiber.Close(gone)
  more = fiber.Receive(requests, timeout = 0)
  while result.IsOk(more)
    if dict.Has("Reply", more.Value)
      fiber.Send(why, more.Value.Reply)
    end
    more = fiber.Receive(requests, timeout = 0)
  end
  if stopped
    _ = websocket.Close(c)
  end
  why
end

failed(r) = match r
  result.Err(_) -> true
  else -> false
end

(* The holds of the Settles of a context, released: each gets Ok(missing). *)
defn released(ctx, held)
  for reply in dict.GetOr(ctx, [], held)
    fiber.Send(result.Ok(missing), reply)
  end
  dict.Drop(ctx, held)
end

(* The subscriptions of the Disarms of a context, ended, in fibers of their own: the dispatcher never waits. *)
defn disarmed(ctx, armed, s)
  for sub in dict.GetOr(ctx, [], armed)
    fiber.Spawn(() -> call("session.unsubscribe", {subscriptions: [sub]}, s))
  end
  dict.Drop(ctx, armed)
end

(* The events that end a navigation: its document has loaded, or it has none to bring, as it failed, became a
   download, or its request ended with no document, for an answer 204 or a stop (Firefox 160 sends no
   navigationAborted, and no event of browsingContext at all for those two: only network.fetchError, which an action
   subscribes to for its own navigation, see act). *)
navigationEnds = ["browsingContext.load", "browsingContext.navigationFailed", "browsingContext.downloadWillBegin", "network.fetchError"]

(* The events of the navigations that the session asks for at its start: no event of the network, since a
   subscription to any of them has Firefox follow every request of every page, at a cost of about 1 ms each, measured
   (19 ms more for a Go of a page of 20 images). *)
navigationEvents = ["browsingContext.navigationStarted", "browsingContext.navigationCommitted", "browsingContext.load", "browsingContext.navigationFailed", "browsingContext.downloadWillBegin"]

(* How many subscriptions of Disarms a context may hold until its navigation has its document: past them, the next
   one ends at once. A page runs one action at a time, so this is room, not a limit that a test meets. *)
maxArmed = 64

(* How many browsing contexts may have a navigation under way at once in the dispatcher's eyes: a page that makes
   frames without end can't fill the memory; past it, a new context's navigation isn't waited for. *)
maxGoing = 1000

defn followed(going, method, e)
  (** The navigations under way, {context: {Navigation, Url, Committed}}, after an event: {Going, Ended, Landed},
      Ended the context whose navigation the event ended, Landed the one whose navigation the event committed or
      ended, or missing. A new navigation of a context takes the place of the one it had. The event is read as any
      message of Firefox: a field of the wrong type leaves things as they were. *)
  same = {Going: going, Ended: missing, Landed: missing}
  ctx = dict.GetOr("context", missing, e)
  nav = dict.GetOr("navigation", missing, e)
  if not value.IsText(ctx) or not value.IsText(nav)
    return same
  end
  if method == "browsingContext.navigationStarted"
    if not dict.Has(ctx, going) and value.Len(going) >= maxGoing
      return same
    end
    url = dict.GetOr("url", "", e)
    return {Going: dict.Put(ctx, {Navigation: nav, Url: if value.IsText(url) url else "" end, Committed: false}, going), Ended: missing, Landed: missing}
  end
  if not dict.Has(ctx, going) or going[ctx].Navigation != nav
    return same
  end
  if method == "browsingContext.navigationCommitted"
    return {Going: dict.Put(ctx, dict.Put("Committed", true, going[ctx]), going), Ended: missing, Landed: ctx}
  end
  if method in navigationEnds
    return {Going: dict.Drop(ctx, going), Ended: ctx, Landed: ctx}
  end
  same
end

(* The request of a network event, a dictionary, or {} for a message that holds none: the tests of the watches, which
   the dispatcher runs, read the events with it and with dict.GetOr, compare with ==, and never panic. *)
requestOf(e) = if value.IsDict(dict.GetOr("request", missing, e)) e.request else {} end

kept(entries) = if value.Len(entries) > consoleEntries list.Skip(1, entries) else entries end   (* The last entries. *)

defn entry(e)
  (** An entry of the console as Console gives it: {Type, Text}, Type the console's method, or "exception" for an
      error that no code caught, Text cut to entryLength characters. *)
  words = dict.GetOr("text", "", e)
  words = if value.IsText(words) words else "" end
  {Type: if dict.GetOr("type", "", e) == "javascript" "exception" else dict.GetOr("method", dict.GetOr("level", "log", e), e) end,
   Text: if value.Len(words) > entryLength text.Slice(1, entryLength, words) else words end}
end

defn answer(m)
  (** The answer to a command as an Ok of its result or an Err of its error, whatever the message holds. *)
  if dict.GetOr("type", "", m) == "success"
    return result.Ok(dict.GetOr("result", {}, m))
  end
  result.Err({Kind: "browser", Code: dict.GetOr("error", "unknown error", m), Message: dict.GetOr("message", "", m)})
end
