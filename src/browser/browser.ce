(** Drives Firefox from Cesia, through WebDriver BiDi, the W3C protocol of browser automation: open a page, click, type,
    read a text, capture the screen, as a test of a web application or a program that automates pages does.
    browser.Firefox starts a Firefox without a window on a profile of its own, a copy of the template that its folder
    keeps for this version of Firefox, gives it to a function, and closes it whatever the function gives, as
    sql.Transaction does for a transaction. Each page has its own user context, so its
    cookies and storage are its own. Click, Type, Text and WaitFor wait in the page for their element, in one round trip.
    The page comes last, as the list in list.Map(f, xs). Errors are values: an Err of {Kind, Message}, its Kind
    "timeout", "browser" (with the Code of BiDi), "script" or "closed". navigator.webdriver stays true: the browser
    says that it is driven, as the W3C WebDriver standard asks, and nothing here hides it. *)
use std/bug
use std/dict
use std/fiber
use std/list
use std/math
use std/path
use std/result
use std/sys
use std/text
use std/value

(* How long Firefox has to say where its BiDi server listens, and then to end, in seconds. *)
startTime = 30
quitTime = 5

(* The line of Firefox's output that gives the address of its BiDi server. *)
listeningOn = "WebDriver BiDi listening on "

defn Firefox(f, dir, headless = true, program = "firefox")
  (** Starts Firefox on a new profile in the folder dir, calls f(b) with the browser b, then closes Firefox and removes
      its profile, whatever f gives, an Ok, an Err or a panic: it gives what f gave, or panics again if f panicked. As
      sql.Transaction does, it runs in a fiber of its own, so that a caller stopped by fiber.Cancel leaves no Firefox
      behind. The profile is a copy of the template that dir keeps for this version of Firefox: the profile of a Firefox
      started once and closed before any page, made at the first start in dir and again when the version changes, and
      never changed by a run, so that no run sees what another one did. A folder kept between runs, as .cesia/firefox,
      gets Firefox ready in about 1.0 s instead of 2.1 s; the first start in it, which makes the template, in about
      4.2 s. headless = false shows the window, to look at a problem. program is the command of Firefox, as
      /Applications/Firefox.app/Contents/MacOS/firefox on macOS. An Err of the kind "browser" when Firefox can't start,
      or doesn't end once closed. It needs exec= for program, net=127.0.0.1 for the port Firefox chooses, and read= and
      write= for dir, where the template and the profiles are made and the profiles removed. *)
  rethrow(result.Unwrap(fiber.Wait(fiber.Spawn(() -> whole(f, dir, headless, program)))))
end

isPanic(x) = value.IsDict(x) and dict.Has("Panic", x)
rethrow(out) = if isPanic(out) bug.Panic(out.Panic) else out end

defn whole(f, dir, headless, program)
  (** Firefox(f, dir): what f gave, or a {Panic} of its message. *)
  profile = newProfile(dir, program)?
  started = launch(program, headless, profile)
  if result.IsErr(started)
    _ = removeTree(profile)
    return started
  end
  fx = started.Value
  opened = connect(fx.Url, profile)
  if result.IsErr(opened)
    _ = quit(missing, fx)
    _ = removeTree(profile)
    return opened
  end
  b = opened.Value
  ran = fiber.Wait(fiber.Spawn(() -> f(b)))
  ended = quit(b, fx)
  removed = removeTree(profile)
  out = match ran
    result.Ok(v) -> v
    result.Err(e) -> {Panic: "$(e.Message) ($(e.File):$(e.Line))"}
  end
  if isPanic(out) or failed(out)
    return out
  end
  ended?
  removed?
  out
end

failed(r) = match r
  result.Err(_) -> true
  else -> false
end

defn newProfile(dir, program)
  (** A new profile in dir for one Firefox: a copy of the template of dir for this version of Firefox, made first when
      dir has none. The template's name holds the version and the build, as firefox --full-version writes them,
      template-Mozilla-Firefox-159.0-20261027034604-20261027034604, since Firefox refuses a profile of a later version
      than its own, and does its first-start work again on one of an earlier version. It is made in a folder of its
      own, then renamed at once, so that a copy never meets one half made: when another Firefox made it meanwhile, its
      own goes. The templates of other versions then go. The copy gets the preferences of prefs. *)
  ran = sys.Run(program, args = ["--full-version"])
  if result.IsErr(ran) or ran.Value.Code != 0
    return result.Err({Kind: "browser", Message: "$program --full-version gave no version."})
  end
  model = "$dir/template-$(text.Replace(" ", "-", text.Trim(ran.Value.Out)))"
  if not sys.Exists(model)
    build = newFolder(dir, "build")?
    made = firstStart(program, build)
    moved = if result.IsOk(made) sys.Rename(build, model) else made end
    if result.IsErr(moved)
      _ = removeTree(build)
      if not sys.Exists(model)
        return moved
      end
    end
    for name in sys.List(dir)?
      if text.StartsWith("template-", name) and "$dir/$name" != model
        _ = removeTree("$dir/$name")
      end
    end
  end
  p = newFolder(dir, "profile")?
  copied = copyTree(model, p)
  copied = if result.IsOk(copied) sys.Write("$p/user.js", prefs) else copied end
  if result.IsErr(copied)
    _ = removeTree(p)
    return copied
  end
  result.Ok(p)
end

(* The preferences that each profile gets in its user.js, which Firefox reads at its start: a turn of the wheel scrolls
   at once, as a test needs, rather than over half a second; a page that asks for its position gets the one that
   Emulate gave, with no question that no one would answer, or else an error at once: never the machine's own place,
   which Firefox would ask of a network service or of GeoClue; and no page is kept in the back-forward cache, so that a
   page that history.back() brings back loads again: Firefox 160 tells of a page taken from that cache only that its
   navigation started, and a step after it would wait for a load that never comes. *)
prefs = "user_pref(\"general.smoothScroll\", false);
user_pref(\"browser.sessionhistory.max_total_viewers\", 0);
user_pref(\"geo.prompt.testing\", true);
user_pref(\"geo.prompt.testing.allow\", true);
user_pref(\"geo.provider.network.url\", \"\");
user_pref(\"geo.provider.use_geoclue\", false);
user_pref(\"geo.provider.use_corelocation\", false);
user_pref(\"geo.provider.use_gpsd\", false);
"

defn newFolder(dir, kind)
  (** A new empty folder in dir: kind, a dash and the time in microseconds, which no other folder of dir has. *)
  sys.Mkdir(dir)?
  n = math.Div(sys.Now() * 1000000, 1)
  while sys.Exists("$dir/$kind-$n")
    n += 1
  end
  p = "$dir/$kind-$n"
  sys.Mkdir(p)?
  result.Ok(p)
end

(* What the first start of a template leaves that is its own, and that no later start needs, besides its lock: its HTTP
   cache, its telemetry, its crash reports, its session, and the list of files that the startup cache read, which names
   them by the path of the build. *)
leftovers = ["cache2", "crashes", "minidumps", "datareporting", "saved-telemetry-pings", "sessionstore.jsonlz4",
  "sessionstore-backups", "sessionCheckpoints.json", "thumbnails", "bookmarkbackups", "startupCache/urlCache.bin"]

defn firstStart(program, profile)
  (** Starts Firefox once on an empty profile, headless, and closes it before any page: the template's work, done once.
      Ok(missing) once Firefox ended by itself with the code 0, with its lock and its leftovers removed, or an Err. *)
  fx = launch(program, true, profile)?
  opened = connect(fx.Url, profile)
  code = quit(if result.IsOk(opened) opened.Value else missing end, fx)?
  opened?
  if code != 0
    return result.Err({Kind: "browser", Message: "Firefox didn't end by itself once closed, on its first start in $profile: no template is kept."})
  end
  _ = sys.Remove("$profile/lock")
  for name in leftovers
    if sys.Exists("$profile/$name")
      removeTree("$profile/$name")?
    end
  end
  result.Ok(missing)
end

defn copyTree(from, to)
  (** Copies the files of a folder into another, at any depth: Ok(missing), or the first Err. A link, or one that leads
      nowhere, is no part of a profile once Firefox has ended, so it is left out. *)
  for name in sys.List(from)?
    s = sys.Stat("$from/$name")
    if result.IsOk(s) and not s.Value.IsLink
      if s.Value.IsDir
        sys.Mkdir("$to/$name")?
        copyTree("$from/$name", "$to/$name")?
      else
        sys.Write("$to/$name", sys.Read("$from/$name")?)?
      end
    end
  end
  result.Ok(missing)
end

defn launch(program, headless, profile)
  (** Starts Firefox on the profile and reads its output up to the address of its BiDi server: an Ok of {Proc, Url,
      Output}, Output the fiber that reads the rest of its output, or an Err once it has stopped. *)
  args = ["--remote-debugging-port=0", "--profile", profile, "--no-remote"]
  proc = sys.Start(program, args = if headless list.Concat(["--headless"], args) else args end)
  if result.IsErr(proc)
    return result.Err({Kind: "browser", Message: "$program didn't start: $(proc.Error.Message)"})
  end
  reading = fiber.Spawn(() -> listening(proc.Value))
  got = fiber.Wait(reading, timeout = startTime)
  if result.IsErr(got)
    fiber.Cancel(reading)
    sys.Stop(proc.Value)
    _ = fiber.Wait(fiber.Spawn(() -> sys.WaitExit(proc.Value)), timeout = quitTime)
    return result.Err({Kind: "browser", Message: "Firefox gave no address of WebDriver BiDi within $startTime seconds."})
  end
  heard = got.Value
  if not value.IsMissing(heard.Url) and not text.StartsWith("ws://127.0.0.1:", heard.Url)
    sys.Stop(proc.Value)
    _ = fiber.Wait(fiber.Spawn(() -> sys.WaitExit(proc.Value)), timeout = quitTime)
    return result.Err({Kind: "browser", Message: "Firefox listens on $(heard.Url), not on 127.0.0.1: Ceti connects to this machine only."})
  end
  if value.IsMissing(heard.Url)
    code = sys.WaitExit(proc.Value)
    return result.Err({Kind: "browser", Message: "Firefox ended with the code $code before it listened. Its last lines:\n$(text.Join("\n", heard.Lines))"})
  end
  result.Ok({Proc: proc.Value, Url: heard.Url, Output: fiber.Spawn(() -> drained(proc.Value, heard.Lines, heard.Rest))})
end

defn listening(proc)
  (** Reads the output of Firefox up to the line that gives the address of its BiDi server: {Url, Lines, Rest}, with Url
      missing if the output ended first. Lines keeps the last 20 lines, Rest what came after the last line end. *)
  lines = []
  rest = ""
  while true
    got = sys.ReadOutput(proc)
    if result.IsErr(got) or got.Value == ""
      return {Url: missing, Lines: lines, Rest: rest}
    end
    parts = text.Split("\n", "$rest$(got.Value)")
    rest = parts[value.Len(parts)]
    for line in list.Take(value.Len(parts) - 1, parts)
      at = text.Find(listeningOn, line)
      if not value.IsMissing(at)
        return {Url: text.Trim(text.Slice(at + value.Len(listeningOn), value.Len(line), line)), Lines: lines, Rest: rest}
      end
      lines = lastLines(list.Append(line, lines))
    end
  end
end

(* The last 20 lines of a list. *)
lastLines(lines) = if value.Len(lines) > 20 list.Skip(value.Len(lines) - 20, lines) else lines end

defn drained(proc, lines, rest)
  (** Reads the output of Firefox to its end, which comes when Firefox and the processes it started have ended, so that
      its pipe never fills: it gives the last 20 lines. *)
  got = sys.ReadOutput(proc)
  while result.IsOk(got) and got.Value != ""
    parts = text.Split("\n", "$rest$(got.Value)")
    rest = parts[value.Len(parts)]
    lines = lastLines(list.Concat(lines, list.Take(value.Len(parts) - 1, parts)))
    got = sys.ReadOutput(proc)
  end
  lines
end

defn connect(url, profile)
  (** Opens the BiDi session of a Firefox on the profile: the WebSocket, session.new, and the tab Firefox opened at its
      start. It asks for the events of the prompts, of the console and of the navigations: the dispatcher dismisses
      each prompt that no Dialog waits for, as no person is there to answer it, keeps the console, and follows the
      navigation under way in each browsing context, for the steps that wait for its document. Downloads are refused:
      without it, Firefox would save a page's download in the user's download folder, where the program never allowed
      a write. *)
  s = open("$url/session")?
  caps = {alwaysMatch: {unhandledPromptBehavior: {default: "ignore"}}}
  started = call("session.new", {capabilities: caps}, s)
  heard = if result.IsOk(started) call("session.subscribe", {events: list.Concat(["browsingContext.userPromptOpened", "log.entryAdded", "browsingContext.navigationStarted"], navigationEnds)}, s) else started end
  denied = if result.IsOk(heard) call("browser.setDownloadBehavior", {downloadBehavior: {type: "denied"}}, s) else heard end
  tree = if result.IsOk(denied) call("browsingContext.getTree", {maxDepth: 0}, s) else denied end
  if result.IsErr(tree)
    hangUp(s)
    return tree
  end
  fiber.Send(tree.Value.contexts[1].context, s.home)
  result.Ok(session(s.requests, s.gone, s.home, s.dispatcher, profile, hereOf(dict.GetOr("moz:profile", missing, started.Value.capabilities), profile)))
end

defn hereOf(full, profile)
  (** The current folder, which Cesia doesn't give: full, the absolute path of the profile that Firefox gives in
      session.new, less the relative path that Ceti gave it; missing when that path is absolute or goes up. *)
  parts = [x for x in text.Split("/", profile) if x != "" and x != "."]
  tail = "/$(text.Join("/", parts))"
  if not value.IsText(full) or path.IsAbsolute(profile) or ".." in parts or not text.EndsWith(tail, full)
    return missing
  end
  text.ByteSlice(1, text.ByteLength(full) - text.ByteLength(tail), full)
end

defn quit(b, fx)
  (** Closes Firefox: browser.close when the session is open, else the TERM signal; then up to quitTime seconds for its
      output to end, which comes when it and the processes it started have ended, and its exit. If it still runs, the
      TERM signal and as long again. Once it has ended, an Ok of its exit code, or of missing when it took a TERM
      signal; an Err of the kind "browser" if it still runs. *)
  stopped = value.IsMissing(b)
  if stopped
    sys.Stop(fx.Proc)
  else
    _ = call("browser.close", {}, b, wait = quitTime)
  end
  quiet = result.IsOk(fiber.Wait(fx.Output, timeout = quitTime))
  exit = fiber.Spawn(() -> sys.WaitExit(fx.Proc))
  ended = fiber.Wait(exit, timeout = if quiet 1 else 0.1 end)
  if result.IsErr(ended)
    sys.Stop(fx.Proc)
    stopped = true
    ended = fiber.Wait(exit, timeout = quitTime)
  end
  if not value.IsMissing(b)
    hangUp(b)
  end
  if result.IsErr(ended)
    return result.Err({Kind: "browser", Message: "Firefox still runs $(2 * quitTime) seconds after it was closed, and after a TERM signal."})
  end
  result.Ok(if stopped missing else ended.Value end)
end

defn removeTree(at)
  (** Removes a folder and all it holds, a link but never what it points to: Ok(missing), or the first Err. A link that
      leads nowhere, as the lock of a profile, has no Stat. *)
  s = sys.Stat(at)
  if result.IsErr(s)
    return sys.Remove(at)
  end
  if s.Value.IsDir and not s.Value.IsLink
    for name in sys.List(at)?
      removeTree("$at/$name")?
    end
  end
  sys.Remove(at)
end
