(* Forms: the choice of a select, the boxes to check, the files of a file field. Typing is in page.ce. *)
use std/dict
use std/json
use std/list
use std/path
use std/result
use std/sys
use std/text
use std/value

defn Select(selector, labels, p, timeout = DefaultTimeout)
  (** Chooses the options of a select by their labels, the text a person reads in the list: a text, or a list of texts
      for a select that takes several, which are then its only chosen ones. It waits for the select, visible and
      enabled, and for those options, which a page may add late. Firefox draws the list of a select outside the page,
      where the mouse of BiDi can't reach, so Ceti makes the choice in the page and sends the events input and change,
      as the browser does after a person's choice; their isTrusted is false. Ok(missing), or an Err of the kind
      "timeout" that names the option missing. A choice that takes the page to another document, by a script of the
      page, waits for it as Click does. A select of one option given several labels is a bug: it panics. *)
  until = sys.Now() + timeout
  seek(selector, "select", p, timeout, arg = json.Text(if value.IsText(labels) [labels] else labels end))?
  landed(p, says(selector), timeout, until = until)
end

Check(selector, p, timeout = DefaultTimeout) = tick(selector, true, p, timeout)   (** Checks a checkbox or a radio, an input or an element of the role checkbox, radio or switch: when it isn't checked, clicks it as Click does, then waits until it is. Ok(missing), or an Err of the kind "timeout". *)

Uncheck(selector, p, timeout = DefaultTimeout) = tick(selector, false, p, timeout)   (** Unchecks a checkbox: when it is checked, clicks it as Click does, then waits until it isn't. Ok(missing), or an Err of the kind "timeout". A radio can't be unchecked by a click, so Uncheck of a checked one is a bug: it panics. *)

defn tick(selector, on, p, timeout)
  (** Check and Uncheck: a click when the box isn't as on says, then a wait until it is. *)
  until = sys.Now() + timeout
  got = seek(selector, "check", p, timeout, arg = "$on")?
  if dict.Has("sharedId", got)
    press(got, p, says(selector), timeout, until)?
    seek(selector, "checked", p, left(until), arg = "$on")?
  end
  result.Ok(missing)
end

defn Upload(selector, files, p, timeout = DefaultTimeout)
  (** Gives a file field its files, as a person picks them in the dialog of the browser: a path, or a list of paths, and
      [] empties it. It waits for an input of type file, shown or not, as a page often hides it behind a button of its
      own; Firefox then sends the events input and change. Firefox reads the files itself, outside the sandbox of Cesia,
      so each one must be a file that the program may read: read= for it, which Cesia checks with the links followed,
      else its Err. Firefox takes absolute paths, so a relative one is taken from the current folder, which Ceti knows
      when the folder given to Firefox is relative, as .cesia/firefox. Ok(missing), or an Err. *)
  full = []
  for f in if value.IsText(files) [files] else files end
    if not sys.Stat(f)?.IsFile
      return result.Err({Kind: "browser", Message: "Upload: $f is no file."})
    end
    full = list.Append(absolute(f, p.session)?, full)
  end
  node = seek(selector, "file", p, timeout)?
  call("input.setFiles", {context: p.context, element: {sharedId: node.sharedId}, files: full}, p.session)?
  result.Ok(missing)
end

defn absolute(f, s)
  (** The absolute path of f, which Firefox needs: f, or f in the current folder; an Err when Ceti can't tell it. *)
  if path.IsAbsolute(f)
    return result.Ok(f)
  end
  if value.IsMissing(s.here)
    return result.Err({Kind: "browser", Message: "$f: Ceti knows the current folder only when the folder of Firefox is relative, as .cesia/firefox; give an absolute path."})
  end
  result.Ok("$(s.here)/$f")
end
